<?xml version="1.0" encoding="UTF-8"?>
<V0idPreset>
  <metadata name="Maintenance Required" category="fx" tags="warning,percussive,degraded"/>
  <v0idSynthParams>
    <!-- Square: the waveform of alerts and warnings -->
    <PARAM id="osc1.waveform" value="1"/>
    <PARAM id="osc1.drive" value="0.55"/>
    <PARAM id="osc2.sample_id" value="0"/>
    <PARAM id="osc.mix" value="0.0"/>
    <!-- Dark base — filter env does all the work. The warning punches through then dies. -->
    <PARAM id="filter.cutoff" value="180.0"/>
    <PARAM id="filter.resonance" value="0.35"/>
    <PARAM id="filter.mode_blend" value="0.0"/>
    <PARAM id="filter.drive" value="0.4"/>
    <!-- 0.88 amount: filter slams open on attack then sags completely shut -->
    <PARAM id="filter.env_amount" value="0.88"/>
    <PARAM id="filter.env.attack" value="0.003"/>
    <PARAM id="filter.env.decay" value="0.28"/>
    <PARAM id="filter.env.sustain" value="0.0"/>
    <PARAM id="filter.env.release" value="0.15"/>
    <!-- Zero sustain: the warning fires, not rings. No drone — just impact. -->
    <PARAM id="amp.env.attack" value="0.003"/>
    <PARAM id="amp.env.decay" value="0.55"/>
    <PARAM id="amp.env.sustain" value="0.0"/>
    <PARAM id="amp.env.release" value="0.2"/>
    <!-- Poly: repeated stabs can stack, like warning alerts piling up -->
    <PARAM id="voice.mode" value="0"/>
    <PARAM id="voice.glide" value="0.0"/>
    <PARAM id="voice.unison_voices" value="1"/>
    <PARAM id="voice.unison_detune" value="0.0"/>
    <PARAM id="voice.unison_spread" value="0.0"/>
    <!-- Degraded equipment: pitch is uncertain -->
    <PARAM id="voice.drift" value="0.2"/>
    <!-- LFO1 S&H: random pitch offset per hit — degraded speaker, each warning lands differently -->
    <PARAM id="mod.lfo1.rate" value="0.8"/>
    <PARAM id="mod.lfo1.waveform" value="4"/>
    <PARAM id="mod.lfo1.depth" value="0.3"/>
    <PARAM id="mod.lfo2.rate" value="1.0"/>
    <PARAM id="mod.lfo2.waveform" value="0"/>
    <PARAM id="mod.lfo2.depth" value="0.0"/>
    <PARAM id="mod.lfo3.rate" value="1.0"/>
    <PARAM id="mod.lfo3.waveform" value="0"/>
    <PARAM id="mod.lfo3.depth" value="0.0"/>
    <PARAM id="mod.lfo4.rate" value="1.0"/>
    <PARAM id="mod.lfo4.waveform" value="0"/>
    <PARAM id="mod.lfo4.depth" value="0.0"/>
    <PARAM id="mod.env1.attack" value="0.01"/>
    <PARAM id="mod.env1.decay" value="0.3"/>
    <PARAM id="mod.env1.sustain" value="0.5"/>
    <PARAM id="mod.env1.release" value="0.5"/>
    <PARAM id="mod.env2.attack" value="0.01"/>
    <PARAM id="mod.env2.decay" value="0.3"/>
    <PARAM id="mod.env2.sustain" value="0.5"/>
    <PARAM id="mod.env2.release" value="0.5"/>
    <PARAM id="mod.env3.attack" value="0.01"/>
    <PARAM id="mod.env3.decay" value="0.3"/>
    <PARAM id="mod.env3.sustain" value="0.5"/>
    <PARAM id="mod.env3.release" value="0.5"/>
    <PARAM id="mod.env4.attack" value="0.01"/>
    <PARAM id="mod.env4.decay" value="0.3"/>
    <PARAM id="mod.env4.sustain" value="0.5"/>
    <PARAM id="mod.env4.release" value="0.5"/>
    <PARAM id="master.gain" value="-6.0"/>
    <ModMatrix>
      <!-- LFO1 S&H 0.8Hz → pitch: each warning fires at a slightly wrong pitch -->
      <Route source="0" dest="2" depth="0.1"/>
      <!-- Drift → pitch: degraded hardware -->
      <Route source="8" dest="2" depth="0.12"/>
    </ModMatrix>
  </v0idSynthParams>
</V0idPreset>
