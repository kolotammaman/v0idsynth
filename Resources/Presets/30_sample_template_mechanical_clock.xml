<?xml version="1.0" encoding="UTF-8"?>
<V0idPreset>
  <metadata name="Mechanical Clock Template" category="sample" tags="template,percussive,worn-mechanism"/>
  <v0idSynthParams>
    <!-- Template: load your percussive or mechanical sample; transient is preserved -->
    <PARAM id="osc1.waveform" value="2"/>
    <PARAM id="osc1.drive" value="0.06"/>
    <PARAM id="osc2.sample_id" value="0"/>
    <PARAM id="osc.mix" value="0.0"/>
    <!-- Open to preserve transient attack character -->
    <PARAM id="filter.cutoff" value="5000.0"/>
    <PARAM id="filter.resonance" value="0.1"/>
    <PARAM id="filter.mode_blend" value="0.0"/>
    <PARAM id="filter.drive" value="0.05"/>
    <PARAM id="filter.env_amount" value="0.0"/>
    <PARAM id="filter.env.attack" value="0.01"/>
    <PARAM id="filter.env.decay" value="0.3"/>
    <PARAM id="filter.env.sustain" value="0.5"/>
    <PARAM id="filter.env.release" value="0.5"/>
    <!-- Immediate click, percussive tail, short release — each tick is its own event -->
    <PARAM id="amp.env.attack" value="0.003"/>
    <PARAM id="amp.env.decay" value="0.5"/>
    <PARAM id="amp.env.sustain" value="0.2"/>
    <PARAM id="amp.env.release" value="0.8"/>
    <!-- Poly: each tick voices independently -->
    <PARAM id="voice.mode" value="0"/>
    <PARAM id="voice.glide" value="0.0"/>
    <PARAM id="voice.unison_voices" value="1"/>
    <PARAM id="voice.unison_detune" value="0.0"/>
    <PARAM id="voice.unison_spread" value="0.0"/>
    <!-- Mechanical variance: never perfectly consistent -->
    <PARAM id="voice.drift" value="0.08"/>
    <!-- LFO1 S&H: each tick has slightly different tonal character — worn gears -->
    <PARAM id="mod.lfo1.rate" value="0.11"/>
    <PARAM id="mod.lfo1.waveform" value="4"/>
    <PARAM id="mod.lfo1.depth" value="0.2"/>
    <PARAM id="mod.lfo2.rate" value="1.0"/>
    <PARAM id="mod.lfo2.waveform" value="0"/>
    <PARAM id="mod.lfo2.depth" value="0.0"/>
    <PARAM id="mod.lfo3.rate" value="1.0"/>
    <PARAM id="mod.lfo3.waveform" value="0"/>
    <PARAM id="mod.lfo3.depth" value="0.0"/>
    <PARAM id="mod.lfo4.rate" value="1.0"/>
    <PARAM id="mod.lfo4.waveform" value="0"/>
    <PARAM id="mod.lfo4.depth" value="0.0"/>
    <PARAM id="mod.env1.attack" value="0.01"/>
    <PARAM id="mod.env1.decay" value="0.3"/>
    <PARAM id="mod.env1.sustain" value="0.5"/>
    <PARAM id="mod.env1.release" value="0.5"/>
    <PARAM id="mod.env2.attack" value="0.01"/>
    <PARAM id="mod.env2.decay" value="0.3"/>
    <PARAM id="mod.env2.sustain" value="0.5"/>
    <PARAM id="mod.env2.release" value="0.5"/>
    <PARAM id="mod.env3.attack" value="0.01"/>
    <PARAM id="mod.env3.decay" value="0.3"/>
    <PARAM id="mod.env3.sustain" value="0.5"/>
    <PARAM id="mod.env3.release" value="0.5"/>
    <PARAM id="mod.env4.attack" value="0.01"/>
    <PARAM id="mod.env4.decay" value="0.3"/>
    <PARAM id="mod.env4.sustain" value="0.5"/>
    <PARAM id="mod.env4.release" value="0.5"/>
    <PARAM id="master.gain" value="-6.0"/>
    <ModMatrix>
      <!-- LFO1 S&H 0.11Hz → filter: 0.2×0.12×10k = 240Hz tone shifts between ticks -->
      <Route source="0" dest="0" depth="0.12"/>
    </ModMatrix>
  </v0idSynthParams>
</V0idPreset>
