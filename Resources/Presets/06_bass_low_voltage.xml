<?xml version="1.0" encoding="UTF-8"?>
<V0idPreset>
  <metadata name="Low Voltage" category="bass" tags="electrical,sag,tremor"/>
  <v0idSynthParams>
    <!-- Saw: harmonically rich, pushed into saturation by starved current -->
    <PARAM id="osc1.waveform" value="0"/>
    <PARAM id="osc1.drive" value="0.6"/>
    <PARAM id="osc2.sample_id" value="0"/>
    <PARAM id="osc.mix" value="0.0"/>
    <!-- Dark base; filter opens briefly on attack then sags shut -->
    <PARAM id="filter.cutoff" value="380.0"/>
    <PARAM id="filter.resonance" value="0.22"/>
    <PARAM id="filter.mode_blend" value="0.0"/>
    <PARAM id="filter.drive" value="0.55"/>
    <!-- 0.72 amount: filter swings wide open, then power starves it back down -->
    <PARAM id="filter.env_amount" value="0.72"/>
    <PARAM id="filter.env.attack" value="0.005"/>
    <PARAM id="filter.env.decay" value="0.5"/>
    <PARAM id="filter.env.sustain" value="0.0"/>
    <PARAM id="filter.env.release" value="0.3"/>
    <PARAM id="amp.env.attack" value="0.015"/>
    <PARAM id="amp.env.decay" value="0.25"/>
    <PARAM id="amp.env.sustain" value="0.8"/>
    <PARAM id="amp.env.release" value="0.45"/>
    <PARAM id="voice.mode" value="1"/>
    <PARAM id="voice.glide" value="0.0"/>
    <PARAM id="voice.unison_voices" value="1"/>
    <PARAM id="voice.unison_detune" value="0.0"/>
    <PARAM id="voice.unison_spread" value="0.0"/>
    <!-- High drift: motor fighting inadequate current destabilizes pitch -->
    <PARAM id="voice.drift" value="0.38"/>
    <!-- LFO1: fast tremolo — voltage tremor at 1.4Hz, like power shaking -->
    <PARAM id="mod.lfo1.rate" value="1.4"/>
    <PARAM id="mod.lfo1.waveform" value="1"/>
    <PARAM id="mod.lfo1.depth" value="0.22"/>
    <!-- LFO2: slow voltage sag — power slowly failing, pitch dragging down -->
    <PARAM id="mod.lfo2.rate" value="0.04"/>
    <PARAM id="mod.lfo2.waveform" value="0"/>
    <PARAM id="mod.lfo2.depth" value="0.12"/>
    <PARAM id="mod.lfo3.rate" value="1.0"/>
    <PARAM id="mod.lfo3.waveform" value="0"/>
    <PARAM id="mod.lfo3.depth" value="0.0"/>
    <PARAM id="mod.lfo4.rate" value="1.0"/>
    <PARAM id="mod.lfo4.waveform" value="0"/>
    <PARAM id="mod.lfo4.depth" value="0.0"/>
    <PARAM id="mod.env1.attack" value="0.01"/>
    <PARAM id="mod.env1.decay" value="0.3"/>
    <PARAM id="mod.env1.sustain" value="0.5"/>
    <PARAM id="mod.env1.release" value="0.5"/>
    <PARAM id="mod.env2.attack" value="0.01"/>
    <PARAM id="mod.env2.decay" value="0.3"/>
    <PARAM id="mod.env2.sustain" value="0.5"/>
    <PARAM id="mod.env2.release" value="0.5"/>
    <PARAM id="mod.env3.attack" value="0.01"/>
    <PARAM id="mod.env3.decay" value="0.3"/>
    <PARAM id="mod.env3.sustain" value="0.5"/>
    <PARAM id="mod.env3.release" value="0.5"/>
    <PARAM id="mod.env4.attack" value="0.01"/>
    <PARAM id="mod.env4.decay" value="0.3"/>
    <PARAM id="mod.env4.sustain" value="0.5"/>
    <PARAM id="mod.env4.release" value="0.5"/>
    <PARAM id="master.gain" value="-3.0"/>
    <ModMatrix>
      <!-- LFO1 triangle 1.4Hz → amp: voltage tremor, power shaking -->
      <Route source="0" dest="4" depth="-0.2"/>
      <!-- LFO2 sine 0.04Hz → pitch: slow voltage sag dragging pitch down -->
      <Route source="1" dest="2" depth="0.05"/>
      <!-- Drift → pitch: motor fighting bad current -->
      <Route source="8" dest="2" depth="0.12"/>
    </ModMatrix>
  </v0idSynthParams>
</V0idPreset>
