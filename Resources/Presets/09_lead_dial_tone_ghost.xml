<?xml version="1.0" encoding="UTF-8"?>
<V0idPreset>
  <metadata name="Dial Tone Ghost" category="lead" tags="thin,persistent,liminal"/>
  <v0idSynthParams>
    <!-- Sine through HP/BP blend: telephone band, the tone that won't stop -->
    <PARAM id="osc1.waveform" value="3"/>
    <PARAM id="osc1.drive" value="0.04"/>
    <PARAM id="osc2.sample_id" value="0"/>
    <PARAM id="osc.mix" value="0.0"/>
    <PARAM id="filter.cutoff" value="4000.0"/>
    <PARAM id="filter.resonance" value="0.6"/>
    <PARAM id="filter.mode_blend" value="1.5"/>
    <PARAM id="filter.drive" value="0.05"/>
    <PARAM id="filter.env_amount" value="0.25"/>
    <!-- Filter env: quick settle into the tone -->
    <PARAM id="filter.env.attack" value="0.001"/>
    <PARAM id="filter.env.decay" value="0.2"/>
    <PARAM id="filter.env.sustain" value="0.8"/>
    <PARAM id="filter.env.release" value="0.3"/>
    <PARAM id="amp.env.attack" value="0.001"/>
    <PARAM id="amp.env.decay" value="0.1"/>
    <PARAM id="amp.env.sustain" value="0.72"/>
    <PARAM id="amp.env.release" value="0.25"/>
    <PARAM id="voice.mode" value="1"/>
    <PARAM id="voice.glide" value="0.0"/>
    <PARAM id="voice.unison_voices" value="1"/>
    <PARAM id="voice.unison_detune" value="0.0"/>
    <PARAM id="voice.unison_spread" value="0.0"/>
    <PARAM id="voice.drift" value="0.05"/>
    <!-- Mod Env1: instant settle, sustained presence -->
    <PARAM id="mod.lfo1.rate" value="0.03"/>
    <PARAM id="mod.lfo1.waveform" value="0"/>
    <PARAM id="mod.lfo1.depth" value="0.15"/>
    <PARAM id="mod.lfo2.rate" value="1.0"/>
    <PARAM id="mod.lfo2.waveform" value="0"/>
    <PARAM id="mod.lfo2.depth" value="0.0"/>
    <PARAM id="mod.lfo3.rate" value="1.0"/>
    <PARAM id="mod.lfo3.waveform" value="0"/>
    <PARAM id="mod.lfo3.depth" value="0.0"/>
    <PARAM id="mod.lfo4.rate" value="1.0"/>
    <PARAM id="mod.lfo4.waveform" value="0"/>
    <PARAM id="mod.lfo4.depth" value="0.0"/>
    <PARAM id="mod.env1.attack" value="0.001"/>
    <PARAM id="mod.env1.decay" value="0.2"/>
    <PARAM id="mod.env1.sustain" value="0.8"/>
    <PARAM id="mod.env1.release" value="0.3"/>
    <PARAM id="mod.env2.attack" value="0.01"/>
    <PARAM id="mod.env2.decay" value="0.3"/>
    <PARAM id="mod.env2.sustain" value="0.5"/>
    <PARAM id="mod.env2.release" value="0.5"/>
    <PARAM id="mod.env3.attack" value="0.01"/>
    <PARAM id="mod.env3.decay" value="0.3"/>
    <PARAM id="mod.env3.sustain" value="0.5"/>
    <PARAM id="mod.env3.release" value="0.5"/>
    <PARAM id="mod.env4.attack" value="0.01"/>
    <PARAM id="mod.env4.decay" value="0.3"/>
    <PARAM id="mod.env4.sustain" value="0.5"/>
    <PARAM id="mod.env4.release" value="0.5"/>
    <PARAM id="master.gain" value="-9.0"/>
    <ModMatrix>
      <!-- Env1 → filter: 0.8×0.3×10k: quick burst then partial sustain -->
      <Route source="4" dest="0" depth="0.3"/>
      <!-- LFO1 sine 0.03Hz → filter: 0.15×0.08×10k = 120Hz extremely slow carrier drift -->
      <Route source="0" dest="0" depth="0.08"/>
    </ModMatrix>
  </v0idSynthParams>
</V0idPreset>
