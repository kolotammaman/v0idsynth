<?xml version="1.0" encoding="UTF-8"?>
<V0idPreset>
  <metadata name="Water Finding Its Level" category="organic" tags="pipes,resonant,settling"/>
  <v0idSynthParams>
    <!-- Triangle: odd harmonics resonate through pipe columns naturally -->
    <PARAM id="osc1.waveform" value="2"/>
    <PARAM id="osc1.drive" value="0.05"/>
    <PARAM id="osc2.sample_id" value="0"/>
    <PARAM id="osc.mix" value="0.0"/>
    <!-- BP at pipe resonance: the water column is a resonator -->
    <PARAM id="filter.cutoff" value="1800.0"/>
    <PARAM id="filter.resonance" value="0.42"/>
    <PARAM id="filter.mode_blend" value="2.0"/>
    <PARAM id="filter.drive" value="0.15"/>
    <PARAM id="filter.env_amount" value="0.0"/>
    <PARAM id="filter.env.attack" value="1.2"/>
    <PARAM id="filter.env.decay" value="0.4"/>
    <PARAM id="filter.env.sustain" value="0.7"/>
    <PARAM id="filter.env.release" value="3.5"/>
    <!-- Water doesn't arrive instantly — it flows in -->
    <PARAM id="amp.env.attack" value="1.2"/>
    <PARAM id="amp.env.decay" value="0.4"/>
    <PARAM id="amp.env.sustain" value="0.75"/>
    <PARAM id="amp.env.release" value="3.5"/>
    <PARAM id="voice.mode" value="2"/>
    <PARAM id="voice.glide" value="0.0"/>
    <!-- 3 voices: the pipes almost agree on the resonant frequency -->
    <PARAM id="voice.unison_voices" value="3"/>
    <PARAM id="voice.unison_detune" value="0.06"/>
    <PARAM id="voice.unison_spread" value="0.45"/>
    <PARAM id="voice.drift" value="0.15"/>
    <!-- LFO1: resonance peak shifting as water level changes -->
    <PARAM id="mod.lfo1.rate" value="0.09"/>
    <PARAM id="mod.lfo1.waveform" value="0"/>
    <PARAM id="mod.lfo1.depth" value="0.3"/>
    <!-- LFO2: very slow amplitude variation — the flow finding equilibrium -->
    <PARAM id="mod.lfo2.rate" value="0.04"/>
    <PARAM id="mod.lfo2.waveform" value="1"/>
    <PARAM id="mod.lfo2.depth" value="0.2"/>
    <PARAM id="mod.lfo3.rate" value="1.0"/>
    <PARAM id="mod.lfo3.waveform" value="0"/>
    <PARAM id="mod.lfo3.depth" value="0.0"/>
    <PARAM id="mod.lfo4.rate" value="1.0"/>
    <PARAM id="mod.lfo4.waveform" value="0"/>
    <PARAM id="mod.lfo4.depth" value="0.0"/>
    <PARAM id="mod.env1.attack" value="0.01"/>
    <PARAM id="mod.env1.decay" value="0.3"/>
    <PARAM id="mod.env1.sustain" value="0.5"/>
    <PARAM id="mod.env1.release" value="0.5"/>
    <PARAM id="mod.env2.attack" value="0.01"/>
    <PARAM id="mod.env2.decay" value="0.3"/>
    <PARAM id="mod.env2.sustain" value="0.5"/>
    <PARAM id="mod.env2.release" value="0.5"/>
    <PARAM id="mod.env3.attack" value="0.01"/>
    <PARAM id="mod.env3.decay" value="0.3"/>
    <PARAM id="mod.env3.sustain" value="0.5"/>
    <PARAM id="mod.env3.release" value="0.5"/>
    <PARAM id="mod.env4.attack" value="0.01"/>
    <PARAM id="mod.env4.decay" value="0.3"/>
    <PARAM id="mod.env4.sustain" value="0.5"/>
    <PARAM id="mod.env4.release" value="0.5"/>
    <PARAM id="master.gain" value="-6.0"/>
    <ModMatrix>
      <!-- LFO1 sine 0.09Hz → filter: 0.3×0.18×10k = 540Hz resonance peak shifting -->
      <Route source="0" dest="0" depth="0.18"/>
      <!-- LFO2 triangle 0.04Hz → amp: 0.2×0.1×1 = 0.02 very slow level variation -->
      <Route source="1" dest="4" depth="-0.1"/>
    </ModMatrix>
  </v0idSynthParams>
</V0idPreset>
