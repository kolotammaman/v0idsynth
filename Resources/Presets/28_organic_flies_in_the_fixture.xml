<?xml version="1.0" encoding="UTF-8"?>
<V0idPreset>
  <metadata name="Flies in the Fixture" category="organic" tags="insects,abandoned,summer"/>
  <v0idSynthParams>
    <!-- Square: insect buzz is narrow-spectrum and harmonically square -->
    <PARAM id="osc1.waveform" value="1"/>
    <PARAM id="osc1.drive" value="0.45"/>
    <PARAM id="osc2.sample_id" value="0"/>
    <PARAM id="osc.mix" value="0.0"/>
    <!-- BP at buzz frequency: insects live in a narrow tonal band -->
    <PARAM id="filter.cutoff" value="2800.0"/>
    <PARAM id="filter.resonance" value="0.25"/>
    <PARAM id="filter.mode_blend" value="2.0"/>
    <PARAM id="filter.drive" value="0.38"/>
    <PARAM id="filter.env_amount" value="0.0"/>
    <PARAM id="filter.env.attack" value="0.005"/>
    <PARAM id="filter.env.decay" value="0.08"/>
    <PARAM id="filter.env.sustain" value="0.5"/>
    <PARAM id="filter.env.release" value="0.3"/>
    <!-- Instant attack: insects don't announce themselves -->
    <PARAM id="amp.env.attack" value="0.005"/>
    <PARAM id="amp.env.decay" value="0.08"/>
    <PARAM id="amp.env.sustain" value="0.55"/>
    <PARAM id="amp.env.release" value="0.6"/>
    <PARAM id="voice.mode" value="0"/>
    <PARAM id="voice.glide" value="0.0"/>
    <!-- 3 voices: multiple insects, not in agreement -->
    <PARAM id="voice.unison_voices" value="3"/>
    <PARAM id="voice.unison_detune" value="0.22"/>
    <PARAM id="voice.unison_spread" value="0.4"/>
    <!-- Highest drift: flies are chaotic -->
    <PARAM id="voice.drift" value="0.48"/>
    <!-- LFO1 S&H: each insect is at a different pitch and timing -->
    <PARAM id="mod.lfo1.rate" value="0.2"/>
    <PARAM id="mod.lfo1.waveform" value="4"/>
    <PARAM id="mod.lfo1.depth" value="0.35"/>
    <!-- LFO2 S&H: irregular amplitude — individual bugs passing by -->
    <PARAM id="mod.lfo2.rate" value="0.08"/>
    <PARAM id="mod.lfo2.waveform" value="4"/>
    <PARAM id="mod.lfo2.depth" value="0.3"/>
    <PARAM id="mod.lfo3.rate" value="1.0"/>
    <PARAM id="mod.lfo3.waveform" value="0"/>
    <PARAM id="mod.lfo3.depth" value="0.0"/>
    <PARAM id="mod.lfo4.rate" value="1.0"/>
    <PARAM id="mod.lfo4.waveform" value="0"/>
    <PARAM id="mod.lfo4.depth" value="0.0"/>
    <PARAM id="mod.env1.attack" value="0.01"/>
    <PARAM id="mod.env1.decay" value="0.3"/>
    <PARAM id="mod.env1.sustain" value="0.5"/>
    <PARAM id="mod.env1.release" value="0.5"/>
    <PARAM id="mod.env2.attack" value="0.01"/>
    <PARAM id="mod.env2.decay" value="0.3"/>
    <PARAM id="mod.env2.sustain" value="0.5"/>
    <PARAM id="mod.env2.release" value="0.5"/>
    <PARAM id="mod.env3.attack" value="0.01"/>
    <PARAM id="mod.env3.decay" value="0.3"/>
    <PARAM id="mod.env3.sustain" value="0.5"/>
    <PARAM id="mod.env3.release" value="0.5"/>
    <PARAM id="mod.env4.attack" value="0.01"/>
    <PARAM id="mod.env4.decay" value="0.3"/>
    <PARAM id="mod.env4.sustain" value="0.5"/>
    <PARAM id="mod.env4.release" value="0.5"/>
    <PARAM id="master.gain" value="-6.0"/>
    <ModMatrix>
      <!-- LFO1 S&H 0.2Hz → filter: 0.35×0.25×10k = 875Hz random tonal jumps -->
      <Route source="0" dest="0" depth="0.25"/>
      <!-- LFO2 S&H 0.08Hz → amp: 0.3×0.2×1 = 0.06 random amplitude — individual bugs -->
      <Route source="1" dest="4" depth="-0.2"/>
    </ModMatrix>
  </v0idSynthParams>
</V0idPreset>
