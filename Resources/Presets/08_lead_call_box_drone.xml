<?xml version="1.0" encoding="UTF-8"?>
<V0idPreset>
  <metadata name="Call Box Drone" category="lead" tags="institutional,intercom,held"/>
  <v0idSynthParams>
    <!-- Square: the waveform of bureaucratic electronics -->
    <PARAM id="osc1.waveform" value="1"/>
    <PARAM id="osc1.drive" value="0.3"/>
    <PARAM id="osc2.sample_id" value="0"/>
    <PARAM id="osc.mix" value="0.0"/>
    <!-- BP at 3200Hz extreme resonance: the specific screech of a tiny speaker against metal -->
    <PARAM id="filter.cutoff" value="3200.0"/>
    <PARAM id="filter.resonance" value="0.75"/>
    <PARAM id="filter.mode_blend" value="2.0"/>
    <PARAM id="filter.drive" value="0.25"/>
    <!-- No filter env — the call box makes the same sound forever -->
    <PARAM id="filter.env_amount" value="0.0"/>
    <PARAM id="filter.env.attack" value="0.01"/>
    <PARAM id="filter.env.decay" value="0.3"/>
    <PARAM id="filter.env.sustain" value="0.7"/>
    <PARAM id="filter.env.release" value="0.3"/>
    <!-- Instant on, held indefinitely — button pressed, nobody responds -->
    <PARAM id="amp.env.attack" value="0.002"/>
    <PARAM id="amp.env.decay" value="0.1"/>
    <PARAM id="amp.env.sustain" value="0.96"/>
    <PARAM id="amp.env.release" value="0.3"/>
    <PARAM id="voice.mode" value="1"/>
    <PARAM id="voice.glide" value="0.0"/>
    <PARAM id="voice.unison_voices" value="1"/>
    <PARAM id="voice.unison_detune" value="0.0"/>
    <PARAM id="voice.unison_spread" value="0.0"/>
    <PARAM id="voice.drift" value="0.12"/>
    <!-- LFO1: 10Hz electrical interference in the filter — AC contamination -->
    <PARAM id="mod.lfo1.rate" value="10.0"/>
    <PARAM id="mod.lfo1.waveform" value="1"/>
    <PARAM id="mod.lfo1.depth" value="0.1"/>
    <!-- LFO2: very slow signal degradation — battery slowly draining -->
    <PARAM id="mod.lfo2.rate" value="0.025"/>
    <PARAM id="mod.lfo2.waveform" value="0"/>
    <PARAM id="mod.lfo2.depth" value="0.12"/>
    <PARAM id="mod.lfo3.rate" value="1.0"/>
    <PARAM id="mod.lfo3.waveform" value="0"/>
    <PARAM id="mod.lfo3.depth" value="0.0"/>
    <PARAM id="mod.lfo4.rate" value="1.0"/>
    <PARAM id="mod.lfo4.waveform" value="0"/>
    <PARAM id="mod.lfo4.depth" value="0.0"/>
    <PARAM id="mod.env1.attack" value="0.01"/>
    <PARAM id="mod.env1.decay" value="0.3"/>
    <PARAM id="mod.env1.sustain" value="0.5"/>
    <PARAM id="mod.env1.release" value="0.5"/>
    <PARAM id="mod.env2.attack" value="0.01"/>
    <PARAM id="mod.env2.decay" value="0.3"/>
    <PARAM id="mod.env2.sustain" value="0.5"/>
    <PARAM id="mod.env2.release" value="0.5"/>
    <PARAM id="mod.env3.attack" value="0.01"/>
    <PARAM id="mod.env3.decay" value="0.3"/>
    <PARAM id="mod.env3.sustain" value="0.5"/>
    <PARAM id="mod.env3.release" value="0.5"/>
    <PARAM id="mod.env4.attack" value="0.01"/>
    <PARAM id="mod.env4.decay" value="0.3"/>
    <PARAM id="mod.env4.sustain" value="0.5"/>
    <PARAM id="mod.env4.release" value="0.5"/>
    <!-- Pulled back — extreme high-resonance BP will be loud -->
    <PARAM id="master.gain" value="-9.0"/>
    <ModMatrix>
      <!-- LFO1 triangle 10Hz → filter: AC interference buzz in the speaker -->
      <Route source="0" dest="0" depth="0.08"/>
      <!-- LFO2 sine 0.025Hz → amp: slow battery drain, ~40s cycle -->
      <Route source="1" dest="4" depth="-0.08"/>
    </ModMatrix>
  </v0idSynthParams>
</V0idPreset>
