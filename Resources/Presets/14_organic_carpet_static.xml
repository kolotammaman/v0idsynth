<?xml version="1.0" encoding="UTF-8"?>
<V0idPreset>
  <metadata name="Carpet Static" category="organic" tags="discharge,tactile,irregular"/>
  <v0idSynthParams>
    <!-- Saw: richer harmonic content = textural spark character -->
    <PARAM id="osc1.waveform" value="0"/>
    <PARAM id="osc1.drive" value="0.32"/>
    <PARAM id="osc2.sample_id" value="0"/>
    <PARAM id="osc.mix" value="0.0"/>
    <PARAM id="filter.cutoff" value="1800.0"/>
    <PARAM id="filter.resonance" value="0.22"/>
    <PARAM id="filter.mode_blend" value="0.0"/>
    <PARAM id="filter.drive" value="0.28"/>
    <PARAM id="filter.env_amount" value="0.3"/>
    <!-- Filter env: sharp crack on each strike -->
    <PARAM id="filter.env.attack" value="0.001"/>
    <PARAM id="filter.env.decay" value="0.09"/>
    <PARAM id="filter.env.sustain" value="0.0"/>
    <PARAM id="filter.env.release" value="0.12"/>
    <PARAM id="amp.env.attack" value="0.003"/>
    <PARAM id="amp.env.decay" value="0.12"/>
    <PARAM id="amp.env.sustain" value="0.7"/>
    <PARAM id="amp.env.release" value="1.0"/>
    <PARAM id="voice.mode" value="0"/>
    <PARAM id="voice.glide" value="0.0"/>
    <PARAM id="voice.unison_voices" value="2"/>
    <PARAM id="voice.unison_detune" value="0.14"/>
    <PARAM id="voice.unison_spread" value="0.3"/>
    <!-- High drift: electrostatic discharge is unpredictable -->
    <PARAM id="voice.drift" value="0.42"/>
    <!-- Mod Env1: sharper crack than the filter env alone; LFO1 S&H for random filter dips -->
    <PARAM id="mod.lfo1.rate" value="0.12"/>
    <PARAM id="mod.lfo1.waveform" value="4"/>
    <PARAM id="mod.lfo1.depth" value="0.35"/>
    <PARAM id="mod.lfo2.rate" value="1.0"/>
    <PARAM id="mod.lfo2.waveform" value="0"/>
    <PARAM id="mod.lfo2.depth" value="0.0"/>
    <PARAM id="mod.lfo3.rate" value="1.0"/>
    <PARAM id="mod.lfo3.waveform" value="0"/>
    <PARAM id="mod.lfo3.depth" value="0.0"/>
    <PARAM id="mod.lfo4.rate" value="1.0"/>
    <PARAM id="mod.lfo4.waveform" value="0"/>
    <PARAM id="mod.lfo4.depth" value="0.0"/>
    <PARAM id="mod.env1.attack" value="0.001"/>
    <PARAM id="mod.env1.decay" value="0.09"/>
    <PARAM id="mod.env1.sustain" value="0.0"/>
    <PARAM id="mod.env1.release" value="0.12"/>
    <PARAM id="mod.env2.attack" value="0.01"/>
    <PARAM id="mod.env2.decay" value="0.3"/>
    <PARAM id="mod.env2.sustain" value="0.5"/>
    <PARAM id="mod.env2.release" value="0.5"/>
    <PARAM id="mod.env3.attack" value="0.01"/>
    <PARAM id="mod.env3.decay" value="0.3"/>
    <PARAM id="mod.env3.sustain" value="0.5"/>
    <PARAM id="mod.env3.release" value="0.5"/>
    <PARAM id="mod.env4.attack" value="0.01"/>
    <PARAM id="mod.env4.decay" value="0.3"/>
    <PARAM id="mod.env4.sustain" value="0.5"/>
    <PARAM id="mod.env4.release" value="0.5"/>
    <PARAM id="master.gain" value="-6.0"/>
    <ModMatrix>
      <!-- Env1 → filter: sharp crack of the discharge, 0.3×10k = 3000Hz pulse -->
      <Route source="4" dest="0" depth="0.3"/>
      <!-- LFO1 S&H 0.12Hz → filter (neg): random dips = static irregularity -->
      <Route source="0" dest="0" depth="-0.2"/>
      <!-- Drift → pitch: crackling is never perfectly in tune -->
      <Route source="8" dest="2" depth="0.2"/>
    </ModMatrix>
  </v0idSynthParams>
</V0idPreset>
