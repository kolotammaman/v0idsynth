<?xml version="1.0" encoding="UTF-8"?>
<V0idPreset>
  <metadata name="Lobby at 3am" category="pad" tags="liminal,vast,climate-controlled"/>
  <v0idSynthParams>
    <!-- Triangle: no edge, no presence — just the space itself -->
    <PARAM id="osc1.waveform" value="2"/>
    <PARAM id="osc1.drive" value="0.06"/>
    <PARAM id="osc2.sample_id" value="0"/>
    <PARAM id="osc.mix" value="0.0"/>
    <!-- Muffled like marble and glass absorbing everything -->
    <PARAM id="filter.cutoff" value="1100.0"/>
    <PARAM id="filter.resonance" value="0.08"/>
    <PARAM id="filter.mode_blend" value="0.0"/>
    <PARAM id="filter.drive" value="0.06"/>
    <PARAM id="filter.env_amount" value="0.0"/>
    <PARAM id="filter.env.attack" value="2.0"/>
    <PARAM id="filter.env.decay" value="1.0"/>
    <PARAM id="filter.env.sustain" value="0.6"/>
    <PARAM id="filter.env.release" value="4.0"/>
    <!-- Materializes over 4s — this place was here before you arrived -->
    <PARAM id="amp.env.attack" value="4.0"/>
    <PARAM id="amp.env.decay" value="0.3"/>
    <PARAM id="amp.env.sustain" value="0.95"/>
    <PARAM id="amp.env.release" value="10.0"/>
    <PARAM id="voice.mode" value="0"/>
    <PARAM id="voice.glide" value="0.0"/>
    <!-- each key its own presence in the space -->
    <PARAM id="voice.unison_voices" value="6"/>
    <PARAM id="voice.unison_detune" value="0.08"/>
    <PARAM id="voice.unison_spread" value="0.9"/>
    <PARAM id="voice.drift" value="0.18"/>
    <!-- LFO1: ~33s cycle, imperceptible filter sway -->
    <PARAM id="mod.lfo1.rate" value="0.03"/>
    <PARAM id="mod.lfo1.waveform" value="0"/>
    <PARAM id="mod.lfo1.depth" value="0.3"/>
    <!-- LFO2: ~67s cycle, the lighting dims and recovers on its own schedule -->
    <PARAM id="mod.lfo2.rate" value="0.015"/>
    <PARAM id="mod.lfo2.waveform" value="0"/>
    <PARAM id="mod.lfo2.depth" value="0.2"/>
    <PARAM id="mod.lfo3.rate" value="1.0"/>
    <PARAM id="mod.lfo3.waveform" value="0"/>
    <PARAM id="mod.lfo3.depth" value="0.0"/>
    <PARAM id="mod.lfo4.rate" value="1.0"/>
    <PARAM id="mod.lfo4.waveform" value="0"/>
    <PARAM id="mod.lfo4.depth" value="0.0"/>
    <PARAM id="mod.env1.attack" value="0.01"/>
    <PARAM id="mod.env1.decay" value="0.3"/>
    <PARAM id="mod.env1.sustain" value="0.5"/>
    <PARAM id="mod.env1.release" value="0.5"/>
    <PARAM id="mod.env2.attack" value="0.01"/>
    <PARAM id="mod.env2.decay" value="0.3"/>
    <PARAM id="mod.env2.sustain" value="0.5"/>
    <PARAM id="mod.env2.release" value="0.5"/>
    <PARAM id="mod.env3.attack" value="0.01"/>
    <PARAM id="mod.env3.decay" value="0.3"/>
    <PARAM id="mod.env3.sustain" value="0.5"/>
    <PARAM id="mod.env3.release" value="0.5"/>
    <PARAM id="mod.env4.attack" value="0.01"/>
    <PARAM id="mod.env4.decay" value="0.3"/>
    <PARAM id="mod.env4.sustain" value="0.5"/>
    <PARAM id="mod.env4.release" value="0.5"/>
    <PARAM id="master.gain" value="-6.0"/>
    <ModMatrix>
      <!-- LFO1 sine 0.03Hz → filter: 0.3×0.2×10k = 600Hz breath over 33s -->
      <Route source="0" dest="0" depth="0.2"/>
      <!-- LFO2 sine 0.015Hz → amp: 0.2×0.07×1 = 0.014, lights on their own schedule -->
      <Route source="1" dest="4" depth="-0.07"/>
    </ModMatrix>
  </v0idSynthParams>
</V0idPreset>
