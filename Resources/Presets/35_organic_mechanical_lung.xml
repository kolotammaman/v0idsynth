<?xml version="1.0" encoding="UTF-8"?>
<V0idPreset>
  <metadata name="Mechanical Lung" category="organic" tags="breathing,pressure,alive"/>
  <v0idSynthParams>
    <!-- Sine wave through a minimal drive — the cleanest possible source,
         then shaped entirely by modulation. LFO1 at 0.14Hz pulls the amp
         down and back up in a 7-second breathing cycle. Env4 adds a secondary
         swell that takes 3 seconds to peak — the breath inside the breath.
         LFO3 S+H at 1.2Hz adds small random pressure variations to the filter. -->
    <PARAM id="osc1.waveform" value="3"/>
    <PARAM id="osc1.drive" value="0.08"/>
    <PARAM id="osc2.sample_id" value="0"/>
    <PARAM id="osc.mix" value="0.0"/>
    <PARAM id="osc2.root_note" value="60"/>
    <PARAM id="osc2.tune" value="0.0"/>
    <PARAM id="osc2.loop" value="0"/>
    <PARAM id="osc2.gain" value="0.0"/>
    <PARAM id="osc2.hpf" value="20.0"/>
    <PARAM id="osc2.lpf" value="20000.0"/>
    <PARAM id="filter.cutoff" value="700.0"/>
    <PARAM id="filter.resonance" value="0.32"/>
    <PARAM id="filter.mode_blend" value="0.0"/>
    <PARAM id="filter.drive" value="0.12"/>
    <PARAM id="filter.env_amount" value="0.22"/>
    <PARAM id="filter.env.attack" value="0.85"/>
    <PARAM id="filter.env.decay" value="1.8"/>
    <PARAM id="filter.env.sustain" value="0.58"/>
    <PARAM id="filter.env.release" value="3.5"/>
    <PARAM id="amp.env.attack" value="0.6"/>
    <PARAM id="amp.env.decay" value="0.18"/>
    <PARAM id="amp.env.sustain" value="1.0"/>
    <PARAM id="amp.env.release" value="4.5"/>
    <PARAM id="voice.mode" value="0"/>
    <PARAM id="voice.glide" value="0.0"/>
    <PARAM id="voice.unison_voices" value="4"/>
    <PARAM id="voice.unison_detune" value="0.32"/>
    <PARAM id="voice.unison_spread" value="0.8"/>
    <PARAM id="voice.drift" value="0.16"/>
    <PARAM id="mod.lfo1.rate" value="0.14"/>
    <PARAM id="mod.lfo1.waveform" value="0"/>
    <PARAM id="mod.lfo1.depth" value="0.68"/>
    <PARAM id="mod.lfo2.rate" value="0.21"/>
    <PARAM id="mod.lfo2.waveform" value="1"/>
    <PARAM id="mod.lfo2.depth" value="0.48"/>
    <PARAM id="mod.lfo3.rate" value="1.2"/>
    <PARAM id="mod.lfo3.waveform" value="4"/>
    <PARAM id="mod.lfo3.depth" value="0.18"/>
    <PARAM id="mod.lfo4.rate" value="0.082"/>
    <PARAM id="mod.lfo4.waveform" value="0"/>
    <PARAM id="mod.lfo4.depth" value="0.32"/>
    <PARAM id="mod.env1.attack" value="1.8"/>
    <PARAM id="mod.env1.decay" value="3.5"/>
    <PARAM id="mod.env1.sustain" value="0.48"/>
    <PARAM id="mod.env1.release" value="5.5"/>
    <PARAM id="mod.env2.attack" value="0.28"/>
    <PARAM id="mod.env2.decay" value="1.2"/>
    <PARAM id="mod.env2.sustain" value="0.0"/>
    <PARAM id="mod.env2.release" value="2.5"/>
    <PARAM id="mod.env3.attack" value="0.08"/>
    <PARAM id="mod.env3.decay" value="3.0"/>
    <PARAM id="mod.env3.sustain" value="0.28"/>
    <PARAM id="mod.env3.release" value="5.0"/>
    <PARAM id="mod.env4.attack" value="3.0"/>
    <PARAM id="mod.env4.decay" value="2.5"/>
    <PARAM id="mod.env4.sustain" value="0.82"/>
    <PARAM id="mod.env4.release" value="7.0"/>
    <PARAM id="master.gain" value="-5.0"/>
    <ModMatrix>
      <!-- LFO1 sine 0.14Hz → amp: −0.68×0.42=−0.286 breathing cycle ~7.1s -->
      <Route source="0" dest="4" depth="-0.42"/>
      <!-- LFO2 tri 0.21Hz → filter: 0.48×0.38×10k=1824Hz air-passage open/close -->
      <Route source="1" dest="0" depth="0.38"/>
      <!-- LFO3 S+H 1.2Hz → filter: 0.18×0.12×10k=216Hz random pressure variations -->
      <Route source="2" dest="0" depth="0.12"/>
      <!-- LFO4 sine 0.082Hz → pitch: 0.32×0.018×1200=6.9¢ very slow pressure sag -->
      <Route source="3" dest="2" depth="0.018"/>
      <!-- Env1 → filter: up to 5200Hz pressure build over 1.8s, sustains at 48% -->
      <Route source="4" dest="0" depth="0.52"/>
      <!-- Env2 → resonance: +0.31 throat resonance on attack, clears over 1.2s -->
      <Route source="5" dest="1" depth="0.62"/>
      <!-- Env3 → pitch: −26¢ Doppler-like bend, resolves over 3s to 28% sustained -->
      <Route source="6" dest="2" depth="-0.022"/>
      <!-- Env4 → amp: +0.28 secondary swell peaking at 3s — breath inside the breath -->
      <Route source="7" dest="4" depth="0.28"/>
    </ModMatrix>
  </v0idSynthParams>
</V0idPreset>
