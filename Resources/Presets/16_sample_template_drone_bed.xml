<?xml version="1.0" encoding="UTF-8"?>
<V0idPreset>
  <metadata name="Drone Bed Template" category="sample" tags="template,patient,barely-moving"/>
  <v0idSynthParams>
    <!-- Template: load your sample; these envelope + mod settings let it drone with intent -->
    <PARAM id="osc1.waveform" value="2"/>
    <PARAM id="osc1.drive" value="0.1"/>
    <PARAM id="osc2.sample_id" value="0"/>
    <PARAM id="osc.mix" value="0.0"/>
    <!-- Open enough to preserve sample timbre; low resonance -->
    <PARAM id="filter.cutoff" value="2000.0"/>
    <PARAM id="filter.resonance" value="0.12"/>
    <PARAM id="filter.mode_blend" value="0.0"/>
    <PARAM id="filter.drive" value="0.12"/>
    <PARAM id="filter.env_amount" value="0.0"/>
    <PARAM id="filter.env.attack" value="3.0"/>
    <PARAM id="filter.env.decay" value="1.0"/>
    <PARAM id="filter.env.sustain" value="0.7"/>
    <PARAM id="filter.env.release" value="5.0"/>
    <!-- Time slowed down: materializes over 3s, lingers for 8s -->
    <PARAM id="amp.env.attack" value="3.0"/>
    <PARAM id="amp.env.decay" value="0.5"/>
    <PARAM id="amp.env.sustain" value="1.0"/>
    <PARAM id="amp.env.release" value="8.0"/>
    <PARAM id="voice.mode" value="0"/>
    <PARAM id="voice.glide" value="0.0"/>
    <PARAM id="voice.unison_voices" value="4"/>
    <PARAM id="voice.unison_detune" value="0.1"/>
    <PARAM id="voice.unison_spread" value="0.7"/>
    <PARAM id="voice.drift" value="0.1"/>
    <!-- Two very slow LFOs targeting different destinations: not redundant -->
    <PARAM id="mod.lfo1.rate" value="0.07"/>
    <PARAM id="mod.lfo1.waveform" value="0"/>
    <PARAM id="mod.lfo1.depth" value="0.3"/>
    <PARAM id="mod.lfo2.rate" value="0.04"/>
    <PARAM id="mod.lfo2.waveform" value="1"/>
    <PARAM id="mod.lfo2.depth" value="0.2"/>
    <PARAM id="mod.lfo3.rate" value="1.0"/>
    <PARAM id="mod.lfo3.waveform" value="0"/>
    <PARAM id="mod.lfo3.depth" value="0.0"/>
    <PARAM id="mod.lfo4.rate" value="1.0"/>
    <PARAM id="mod.lfo4.waveform" value="0"/>
    <PARAM id="mod.lfo4.depth" value="0.0"/>
    <PARAM id="mod.env1.attack" value="0.01"/>
    <PARAM id="mod.env1.decay" value="0.3"/>
    <PARAM id="mod.env1.sustain" value="0.5"/>
    <PARAM id="mod.env1.release" value="0.5"/>
    <PARAM id="mod.env2.attack" value="0.01"/>
    <PARAM id="mod.env2.decay" value="0.3"/>
    <PARAM id="mod.env2.sustain" value="0.5"/>
    <PARAM id="mod.env2.release" value="0.5"/>
    <PARAM id="mod.env3.attack" value="0.01"/>
    <PARAM id="mod.env3.decay" value="0.3"/>
    <PARAM id="mod.env3.sustain" value="0.5"/>
    <PARAM id="mod.env3.release" value="0.5"/>
    <PARAM id="mod.env4.attack" value="0.01"/>
    <PARAM id="mod.env4.decay" value="0.3"/>
    <PARAM id="mod.env4.sustain" value="0.5"/>
    <PARAM id="mod.env4.release" value="0.5"/>
    <PARAM id="master.gain" value="-6.0"/>
    <ModMatrix>
      <!-- LFO1 sine 0.07Hz → filter: 0.3×0.25×10k = 750Hz slow filter breath -->
      <Route source="0" dest="0" depth="0.25"/>
      <!-- LFO2 triangle 0.04Hz → amp: 0.2×0.12×1 = 0.024 very slow volume sag -->
      <Route source="1" dest="4" depth="-0.12"/>
    </ModMatrix>
  </v0idSynthParams>
</V0idPreset>
