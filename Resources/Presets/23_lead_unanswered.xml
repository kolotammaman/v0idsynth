<?xml version="1.0" encoding="UTF-8"?>
<V0idPreset>
  <metadata name="Unanswered" category="lead" tags="telephone,hollow,ringing"/>
  <v0idSynthParams>
    <!-- Square: classic telephone band, hollow and narrow -->
    <PARAM id="osc1.waveform" value="1"/>
    <PARAM id="osc1.drive" value="0.15"/>
    <PARAM id="osc2.sample_id" value="0"/>
    <PARAM id="osc.mix" value="0.0"/>
    <!-- BP at telephone band center; the resonance gives the ringing quality -->
    <PARAM id="filter.cutoff" value="1800.0"/>
    <PARAM id="filter.resonance" value="0.45"/>
    <PARAM id="filter.mode_blend" value="2.0"/>
    <PARAM id="filter.drive" value="0.2"/>
    <PARAM id="filter.env_amount" value="0.4"/>
    <!-- Filter env: brightens on each note, retreats like the ring dying out -->
    <PARAM id="filter.env.attack" value="0.05"/>
    <PARAM id="filter.env.decay" value="0.35"/>
    <PARAM id="filter.env.sustain" value="0.3"/>
    <PARAM id="filter.env.release" value="0.5"/>
    <PARAM id="amp.env.attack" value="0.01"/>
    <PARAM id="amp.env.decay" value="0.15"/>
    <PARAM id="amp.env.sustain" value="0.75"/>
    <PARAM id="amp.env.release" value="0.4"/>
    <!-- Mono: one phone, one ring, nobody picking up -->
    <PARAM id="voice.mode" value="1"/>
    <PARAM id="voice.glide" value="0.0"/>
    <PARAM id="voice.unison_voices" value="1"/>
    <PARAM id="voice.unison_detune" value="0.0"/>
    <PARAM id="voice.unison_spread" value="0.0"/>
    <PARAM id="voice.drift" value="0.1"/>
    <!-- LFO1: telephone line instability, ~12.5s cycle -->
    <PARAM id="mod.lfo1.rate" value="0.08"/>
    <PARAM id="mod.lfo1.waveform" value="0"/>
    <PARAM id="mod.lfo1.depth" value="0.15"/>
    <PARAM id="mod.lfo2.rate" value="1.0"/>
    <PARAM id="mod.lfo2.waveform" value="0"/>
    <PARAM id="mod.lfo2.depth" value="0.0"/>
    <PARAM id="mod.lfo3.rate" value="1.0"/>
    <PARAM id="mod.lfo3.waveform" value="0"/>
    <PARAM id="mod.lfo3.depth" value="0.0"/>
    <PARAM id="mod.lfo4.rate" value="1.0"/>
    <PARAM id="mod.lfo4.waveform" value="0"/>
    <PARAM id="mod.lfo4.depth" value="0.0"/>
    <!-- Env1: same shape as filter env — the ring sharpness mirrored into mod -->
    <PARAM id="mod.env1.attack" value="0.05"/>
    <PARAM id="mod.env1.decay" value="0.35"/>
    <PARAM id="mod.env1.sustain" value="0.3"/>
    <PARAM id="mod.env1.release" value="0.5"/>
    <PARAM id="mod.env2.attack" value="0.01"/>
    <PARAM id="mod.env2.decay" value="0.3"/>
    <PARAM id="mod.env2.sustain" value="0.5"/>
    <PARAM id="mod.env2.release" value="0.5"/>
    <PARAM id="mod.env3.attack" value="0.01"/>
    <PARAM id="mod.env3.decay" value="0.3"/>
    <PARAM id="mod.env3.sustain" value="0.5"/>
    <PARAM id="mod.env3.release" value="0.5"/>
    <PARAM id="mod.env4.attack" value="0.01"/>
    <PARAM id="mod.env4.decay" value="0.3"/>
    <PARAM id="mod.env4.sustain" value="0.5"/>
    <PARAM id="mod.env4.release" value="0.5"/>
    <PARAM id="master.gain" value="-6.0"/>
    <ModMatrix>
      <!-- Env1 → filter: 0.4×10k = 4000Hz push per ring, retreating to hollow band -->
      <Route source="4" dest="0" depth="0.4"/>
      <!-- LFO1 sine 0.08Hz → filter: 0.15×0.06×10k = 90Hz line wobble -->
      <Route source="0" dest="0" depth="0.06"/>
    </ModMatrix>
  </v0idSynthParams>
</V0idPreset>
