<?xml version="1.0" encoding="UTF-8"?>
<V0idPreset>
  <metadata name="Cassette That Won't Rewind" category="fx" tags="tape,drooping,mechanical-failure"/>
  <v0idSynthParams>
    <!-- Square: that hollow cassette midrange, slightly worn -->
    <PARAM id="osc1.waveform" value="1"/>
    <PARAM id="osc1.drive" value="0.35"/>
    <PARAM id="osc2.sample_id" value="0"/>
    <PARAM id="osc.mix" value="0.0"/>
    <!-- Cassette bandwidth: not hi-fi, not broken — just limited -->
    <PARAM id="filter.cutoff" value="2200.0"/>
    <PARAM id="filter.resonance" value="0.3"/>
    <PARAM id="filter.mode_blend" value="2.0"/>
    <PARAM id="filter.drive" value="0.3"/>
    <PARAM id="filter.env_amount" value="0.0"/>
    <PARAM id="filter.env.attack" value="0.05"/>
    <PARAM id="filter.env.decay" value="0.3"/>
    <PARAM id="filter.env.sustain" value="0.6"/>
    <PARAM id="filter.env.release" value="0.8"/>
    <PARAM id="amp.env.attack" value="0.02"/>
    <PARAM id="amp.env.decay" value="0.3"/>
    <PARAM id="amp.env.sustain" value="0.8"/>
    <PARAM id="amp.env.release" value="1.5"/>
    <PARAM id="voice.mode" value="2"/>
    <PARAM id="voice.glide" value="0.0"/>
    <!-- 2 voices: the wow of two tape heads not quite synced -->
    <PARAM id="voice.unison_voices" value="2"/>
    <PARAM id="voice.unison_detune" value="0.08"/>
    <PARAM id="voice.unison_spread" value="0.35"/>
    <!-- High flutter: worn tape is never stable -->
    <PARAM id="voice.drift" value="0.38"/>
    <!-- LFO1: slow saw ~50s cycle — pitch drooping downward without recovery -->
    <PARAM id="mod.lfo1.rate" value="0.02"/>
    <PARAM id="mod.lfo1.waveform" value="2"/>
    <PARAM id="mod.lfo1.depth" value="0.45"/>
    <PARAM id="mod.lfo2.rate" value="1.0"/>
    <PARAM id="mod.lfo2.waveform" value="0"/>
    <PARAM id="mod.lfo2.depth" value="0.0"/>
    <PARAM id="mod.lfo3.rate" value="1.0"/>
    <PARAM id="mod.lfo3.waveform" value="0"/>
    <PARAM id="mod.lfo3.depth" value="0.0"/>
    <PARAM id="mod.lfo4.rate" value="1.0"/>
    <PARAM id="mod.lfo4.waveform" value="0"/>
    <PARAM id="mod.lfo4.depth" value="0.0"/>
    <PARAM id="mod.env1.attack" value="0.01"/>
    <PARAM id="mod.env1.decay" value="0.3"/>
    <PARAM id="mod.env1.sustain" value="0.5"/>
    <PARAM id="mod.env1.release" value="0.5"/>
    <PARAM id="mod.env2.attack" value="0.01"/>
    <PARAM id="mod.env2.decay" value="0.3"/>
    <PARAM id="mod.env2.sustain" value="0.5"/>
    <PARAM id="mod.env2.release" value="0.5"/>
    <PARAM id="mod.env3.attack" value="0.01"/>
    <PARAM id="mod.env3.decay" value="0.3"/>
    <PARAM id="mod.env3.sustain" value="0.5"/>
    <PARAM id="mod.env3.release" value="0.5"/>
    <PARAM id="mod.env4.attack" value="0.01"/>
    <PARAM id="mod.env4.decay" value="0.3"/>
    <PARAM id="mod.env4.sustain" value="0.5"/>
    <PARAM id="mod.env4.release" value="0.5"/>
    <PARAM id="master.gain" value="-6.0"/>
    <ModMatrix>
      <!-- LFO1 saw 0.02Hz → pitch (neg): 0.45×0.05×1200 = 27 cents droop over 50s — committing to failure -->
      <Route source="0" dest="2" depth="-0.05"/>
      <!-- Drift → pitch: tape flutter, always present -->
      <Route source="8" dest="2" depth="0.2"/>
    </ModMatrix>
  </v0idSynthParams>
</V0idPreset>
