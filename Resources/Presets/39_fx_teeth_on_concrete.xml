<?xml version="1.0" encoding="UTF-8"?>
<V0idPreset>
  <metadata name="Teeth on Concrete" category="fx" tags="abrasive,scraping,horrible"/>
  <v0idSynthParams>
    <!-- Poly, 4 unison voices. The source is a heavily driven saw — almost white noise
         when pushed through the LP at extreme resonance.
         LFO2 square at 17Hz: faster than tremolo, slower than audio rate.
         Produces an unpleasant comb-like stutter in the amplitude — not rhythmic,
         just wrong. LFO1 S+H at 1.8Hz steps the filter cutoff through
         random positions, so the resonant peak appears at different frequencies
         on each hit — each scrape finds a different nerve.
         Env3 fires a -500Hz filter plunge on every note-on and recovers
         over 800ms, the sound of something dragged unwillingly downward.
         Drift at 0.72 ensures the four voices are maximally out of agreement. -->
    <PARAM id="osc1.waveform" value="2"/>
    <PARAM id="osc1.drive" value="0.88"/>
    <PARAM id="osc2.sample_id" value="0"/>
    <PARAM id="osc.mix" value="0.0"/>
    <PARAM id="osc2.root_note" value="60"/>
    <PARAM id="osc2.tune" value="0.0"/>
    <PARAM id="osc2.loop" value="0"/>
    <PARAM id="osc2.gain" value="0.0"/>
    <PARAM id="osc2.hpf" value="20.0"/>
    <PARAM id="osc2.lpf" value="20000.0"/>
    <PARAM id="filter.cutoff" value="3500.0"/>
    <PARAM id="filter.resonance" value="0.82"/>
    <PARAM id="filter.mode_blend" value="0.0"/>
    <PARAM id="filter.drive" value="0.72"/>
    <PARAM id="filter.env_amount" value="0.45"/>
    <PARAM id="filter.env.attack" value="0.001"/>
    <PARAM id="filter.env.decay" value="0.8"/>
    <PARAM id="filter.env.sustain" value="0.35"/>
    <PARAM id="filter.env.release" value="3.0"/>
    <PARAM id="amp.env.attack" value="0.001"/>
    <PARAM id="amp.env.decay" value="0.45"/>
    <PARAM id="amp.env.sustain" value="0.88"/>
    <PARAM id="amp.env.release" value="1.5"/>
    <PARAM id="voice.mode" value="0"/>
    <PARAM id="voice.glide" value="0.0"/>
    <PARAM id="voice.unison_voices" value="4"/>
    <PARAM id="voice.unison_detune" value="0.45"/>
    <PARAM id="voice.unison_spread" value="0.75"/>
    <PARAM id="voice.drift" value="0.72"/>
    <PARAM id="mod.lfo1.rate" value="1.8"/>
    <PARAM id="mod.lfo1.waveform" value="4"/>
    <PARAM id="mod.lfo1.depth" value="0.82"/>
    <PARAM id="mod.lfo2.rate" value="17.0"/>
    <PARAM id="mod.lfo2.waveform" value="3"/>
    <PARAM id="mod.lfo2.depth" value="0.55"/>
    <PARAM id="mod.lfo3.rate" value="0.055"/>
    <PARAM id="mod.lfo3.waveform" value="0"/>
    <PARAM id="mod.lfo3.depth" value="0.48"/>
    <PARAM id="mod.lfo4.rate" value="0.28"/>
    <PARAM id="mod.lfo4.waveform" value="1"/>
    <PARAM id="mod.lfo4.depth" value="0.38"/>
    <PARAM id="mod.env1.attack" value="0.001"/>
    <PARAM id="mod.env1.decay" value="0.38"/>
    <PARAM id="mod.env1.sustain" value="0.0"/>
    <PARAM id="mod.env1.release" value="0.5"/>
    <PARAM id="mod.env2.attack" value="0.001"/>
    <PARAM id="mod.env2.decay" value="1.5"/>
    <PARAM id="mod.env2.sustain" value="0.0"/>
    <PARAM id="mod.env2.release" value="2.0"/>
    <PARAM id="mod.env3.attack" value="0.001"/>
    <PARAM id="mod.env3.decay" value="0.8"/>
    <PARAM id="mod.env3.sustain" value="0.35"/>
    <PARAM id="mod.env3.release" value="1.5"/>
    <PARAM id="mod.env4.attack" value="0.001"/>
    <PARAM id="mod.env4.decay" value="2.2"/>
    <PARAM id="mod.env4.sustain" value="0.0"/>
    <PARAM id="mod.env4.release" value="3.0"/>
    <PARAM id="master.gain" value="-8.0"/>
    <ModMatrix>
      <!-- LFO1 S+H 1.8Hz: filter jumps 0.82x0.55x10k=4510Hz — each scrape finds a nerve -->
      <Route source="0" dest="0" depth="0.55"/>
      <!-- LFO2 square 17Hz: amp -0.55x0.48=-0.264 sub-tremolo stutter — just wrong -->
      <Route source="1" dest="4" depth="-0.48"/>
      <!-- LFO3 sine 0.055Hz: resonance 0.48x0.35x0.5=0.084 slow pressure change -->
      <Route source="2" dest="1" depth="0.35"/>
      <!-- LFO4 tri 0.28Hz: pitch 0.38x0.035x1200=16c wobble — detuning that catches -->
      <Route source="3" dest="2" depth="0.035"/>
      <!-- Env1: pitch -62c downward snap on attack, clears over 380ms -->
      <Route source="4" dest="2" depth="-0.052"/>
      <!-- Env2: resonance +0.48 bloom over 1.5s, then gone — the resonance peaks late -->
      <Route source="5" dest="1" depth="0.96"/>
      <!-- Env3: filter -5000Hz plunge on note-on, drags upward over 800ms -->
      <Route source="6" dest="0" depth="-0.5"/>
      <!-- Env4: amp +0.22 surge then gone in 2.2s — the scrape gets louder then stops -->
      <Route source="7" dest="4" depth="0.22"/>
      <!-- Drift: 0.72x0.25x1200=216c scatter across 4 voices — maximum disagreement -->
      <Route source="8" dest="2" depth="0.25"/>
    </ModMatrix>
  </v0idSynthParams>
</V0idPreset>
