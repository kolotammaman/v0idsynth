<?xml version="1.0" encoding="UTF-8"?>
<V0idPreset>
  <metadata name="Breath in the Walls" category="organic" tags="hvac,mechanical,cycling"/>
  <v0idSynthParams>
    <!-- Saw: the harmonic character of forced air through metal ducting -->
    <PARAM id="osc1.waveform" value="0"/>
    <PARAM id="osc1.drive" value="0.2"/>
    <PARAM id="osc2.sample_id" value="0"/>
    <PARAM id="osc.mix" value="0.0"/>
    <!-- Very dark LP: the sound arrives filtered through walls and insulation -->
    <PARAM id="filter.cutoff" value="650.0"/>
    <PARAM id="filter.resonance" value="0.07"/>
    <PARAM id="filter.mode_blend" value="0.0"/>
    <PARAM id="filter.drive" value="0.18"/>
    <PARAM id="filter.env_amount" value="0.0"/>
    <PARAM id="filter.env.attack" value="1.5"/>
    <PARAM id="filter.env.decay" value="1.0"/>
    <PARAM id="filter.env.sustain" value="0.6"/>
    <PARAM id="filter.env.release" value="3.0"/>
    <!-- 0.4s: the system spools up quickly, not like a living breath -->
    <PARAM id="amp.env.attack" value="0.4"/>
    <PARAM id="amp.env.decay" value="0.1"/>
    <PARAM id="amp.env.sustain" value="0.96"/>
    <PARAM id="amp.env.release" value="3.5"/>
    <PARAM id="voice.mode" value="0"/>
    <PARAM id="voice.glide" value="0.0"/>
    <!-- 2 voices: slight chorus from two duct openings in the same room -->
    <PARAM id="voice.unison_voices" value="2"/>
    <PARAM id="voice.unison_detune" value="0.06"/>
    <PARAM id="voice.unison_spread" value="0.55"/>
    <!-- Mechanical: low drift -->
    <PARAM id="voice.drift" value="0.07"/>
    <!-- LFO1: ~15s HVAC breathing cycle — same LFO drives both filter and amp -->
    <PARAM id="mod.lfo1.rate" value="0.065"/>
    <PARAM id="mod.lfo1.waveform" value="0"/>
    <PARAM id="mod.lfo1.depth" value="0.3"/>
    <!-- LFO2: fan blade rotation at 0.65Hz — subtle motor pitch shimmer -->
    <PARAM id="mod.lfo2.rate" value="0.65"/>
    <PARAM id="mod.lfo2.waveform" value="1"/>
    <PARAM id="mod.lfo2.depth" value="0.05"/>
    <PARAM id="mod.lfo3.rate" value="1.0"/>
    <PARAM id="mod.lfo3.waveform" value="0"/>
    <PARAM id="mod.lfo3.depth" value="0.0"/>
    <PARAM id="mod.lfo4.rate" value="1.0"/>
    <PARAM id="mod.lfo4.waveform" value="0"/>
    <PARAM id="mod.lfo4.depth" value="0.0"/>
    <PARAM id="mod.env1.attack" value="0.01"/>
    <PARAM id="mod.env1.decay" value="0.3"/>
    <PARAM id="mod.env1.sustain" value="0.5"/>
    <PARAM id="mod.env1.release" value="0.5"/>
    <PARAM id="mod.env2.attack" value="0.01"/>
    <PARAM id="mod.env2.decay" value="0.3"/>
    <PARAM id="mod.env2.sustain" value="0.5"/>
    <PARAM id="mod.env2.release" value="0.5"/>
    <PARAM id="mod.env3.attack" value="0.01"/>
    <PARAM id="mod.env3.decay" value="0.3"/>
    <PARAM id="mod.env3.sustain" value="0.5"/>
    <PARAM id="mod.env3.release" value="0.5"/>
    <PARAM id="mod.env4.attack" value="0.01"/>
    <PARAM id="mod.env4.decay" value="0.3"/>
    <PARAM id="mod.env4.sustain" value="0.5"/>
    <PARAM id="mod.env4.release" value="0.5"/>
    <PARAM id="master.gain" value="-6.0"/>
    <ModMatrix>
      <!-- LFO1 sine 0.065Hz → filter: same breath cycle opens the tone -->
      <Route source="0" dest="0" depth="0.22"/>
      <!-- LFO1 sine 0.065Hz → amp: filter and volume swell together, mechanical breath -->
      <Route source="0" dest="4" depth="-0.12"/>
      <!-- LFO2 triangle 0.65Hz → pitch: fan blade rotation frequency -->
      <Route source="1" dest="2" depth="0.012"/>
    </ModMatrix>
  </v0idSynthParams>
</V0idPreset>
