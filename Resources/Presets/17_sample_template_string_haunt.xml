<?xml version="1.0" encoding="UTF-8"?>
<V0idPreset>
  <metadata name="String Haunt Template" category="sample" tags="template,ensemble,quietly-wrong"/>
  <v0idSynthParams>
    <!-- Template: load your string/bowed sample; unison spreads it naturally -->
    <PARAM id="osc1.waveform" value="0"/>
    <PARAM id="osc1.drive" value="0.12"/>
    <PARAM id="osc2.sample_id" value="0"/>
    <PARAM id="osc.mix" value="0.0"/>
    <!-- Open filter: preserve sample timbre, very low resonance -->
    <PARAM id="filter.cutoff" value="4500.0"/>
    <PARAM id="filter.resonance" value="0.1"/>
    <PARAM id="filter.mode_blend" value="0.0"/>
    <PARAM id="filter.drive" value="0.1"/>
    <PARAM id="filter.env_amount" value="0.0"/>
    <PARAM id="filter.env.attack" value="1.5"/>
    <PARAM id="filter.env.decay" value="0.8"/>
    <PARAM id="filter.env.sustain" value="0.65"/>
    <PARAM id="filter.env.release" value="3.0"/>
    <PARAM id="amp.env.attack" value="1.5"/>
    <PARAM id="amp.env.decay" value="0.3"/>
    <PARAM id="amp.env.sustain" value="0.92"/>
    <PARAM id="amp.env.release" value="5.0"/>
    <PARAM id="voice.mode" value="2"/>
    <PARAM id="voice.glide" value="0.0"/>
    <!-- Natural ensemble width: 4 voices, gentle detune -->
    <PARAM id="voice.unison_voices" value="4"/>
    <PARAM id="voice.unison_detune" value="0.18"/>
    <PARAM id="voice.unison_spread" value="0.8"/>
    <PARAM id="voice.drift" value="0.12"/>
    <!-- LFO1: subtle bowing vibrato; LFO2: slow tonal evolution -->
    <PARAM id="mod.lfo1.rate" value="4.8"/>
    <PARAM id="mod.lfo1.waveform" value="0"/>
    <PARAM id="mod.lfo1.depth" value="0.15"/>
    <PARAM id="mod.lfo2.rate" value="0.08"/>
    <PARAM id="mod.lfo2.waveform" value="1"/>
    <PARAM id="mod.lfo2.depth" value="0.2"/>
    <PARAM id="mod.lfo3.rate" value="1.0"/>
    <PARAM id="mod.lfo3.waveform" value="0"/>
    <PARAM id="mod.lfo3.depth" value="0.0"/>
    <PARAM id="mod.lfo4.rate" value="1.0"/>
    <PARAM id="mod.lfo4.waveform" value="0"/>
    <PARAM id="mod.lfo4.depth" value="0.0"/>
    <PARAM id="mod.env1.attack" value="0.01"/>
    <PARAM id="mod.env1.decay" value="0.3"/>
    <PARAM id="mod.env1.sustain" value="0.5"/>
    <PARAM id="mod.env1.release" value="0.5"/>
    <PARAM id="mod.env2.attack" value="0.01"/>
    <PARAM id="mod.env2.decay" value="0.3"/>
    <PARAM id="mod.env2.sustain" value="0.5"/>
    <PARAM id="mod.env2.release" value="0.5"/>
    <PARAM id="mod.env3.attack" value="0.01"/>
    <PARAM id="mod.env3.decay" value="0.3"/>
    <PARAM id="mod.env3.sustain" value="0.5"/>
    <PARAM id="mod.env3.release" value="0.5"/>
    <PARAM id="mod.env4.attack" value="0.01"/>
    <PARAM id="mod.env4.decay" value="0.3"/>
    <PARAM id="mod.env4.sustain" value="0.5"/>
    <PARAM id="mod.env4.release" value="0.5"/>
    <PARAM id="master.gain" value="-6.0"/>
    <ModMatrix>
      <!-- LFO1 sine 4.8Hz → pitch: 0.15×0.04×1200 = 7.2 cents barely-there vibrato -->
      <Route source="0" dest="2" depth="0.04"/>
      <!-- LFO2 triangle 0.08Hz → filter: 0.2×0.15×10k = 300Hz slow tonal swell -->
      <Route source="1" dest="0" depth="0.15"/>
    </ModMatrix>
  </v0idSynthParams>
</V0idPreset>
