<?xml version="1.0" encoding="UTF-8"?>
<V0idPreset>
  <metadata name="The Painting Is Watching" category="pad" tags="uncanny,observed,stillness"/>
  <v0idSynthParams>
    <!-- Sine: pure, clinical, unsettling in its lack of character -->
    <PARAM id="osc1.waveform" value="3"/>
    <PARAM id="osc1.drive" value="0.0"/>
    <PARAM id="osc2.sample_id" value="0"/>
    <PARAM id="osc.mix" value="0.0"/>
    <!-- Dark but colored — a specific, knowing presence -->
    <PARAM id="filter.cutoff" value="600.0"/>
    <PARAM id="filter.resonance" value="0.28"/>
    <PARAM id="filter.mode_blend" value="0.0"/>
    <PARAM id="filter.drive" value="0.08"/>
    <PARAM id="filter.env_amount" value="0.0"/>
    <PARAM id="filter.env.attack" value="3.0"/>
    <PARAM id="filter.env.decay" value="1.5"/>
    <PARAM id="filter.env.sustain" value="0.5"/>
    <PARAM id="filter.env.release" value="5.0"/>
    <!-- 5s to fully arrive: presences don't rush -->
    <PARAM id="amp.env.attack" value="5.0"/>
    <PARAM id="amp.env.decay" value="0.5"/>
    <PARAM id="amp.env.sustain" value="0.88"/>
    <PARAM id="amp.env.release" value="8.0"/>
    <PARAM id="voice.mode" value="0"/>
    <PARAM id="voice.glide" value="0.0"/>
    <!-- each voice is watched independently -->
    <PARAM id="voice.unison_voices" value="3"/>
    <PARAM id="voice.unison_detune" value="0.14"/>
    <PARAM id="voice.unison_spread" value="0.55"/>
    <PARAM id="voice.drift" value="0.28"/>
    <!-- LFO1: ~25s cycle pitch drift — this thing is breathing -->
    <PARAM id="mod.lfo1.rate" value="0.04"/>
    <PARAM id="mod.lfo1.waveform" value="0"/>
    <PARAM id="mod.lfo1.depth" value="0.2"/>
    <!-- LFO2: ~12.5s filter shift — attention moving slowly across you -->
    <PARAM id="mod.lfo2.rate" value="0.08"/>
    <PARAM id="mod.lfo2.waveform" value="1"/>
    <PARAM id="mod.lfo2.depth" value="0.25"/>
    <PARAM id="mod.lfo3.rate" value="1.0"/>
    <PARAM id="mod.lfo3.waveform" value="0"/>
    <PARAM id="mod.lfo3.depth" value="0.0"/>
    <PARAM id="mod.lfo4.rate" value="1.0"/>
    <PARAM id="mod.lfo4.waveform" value="0"/>
    <PARAM id="mod.lfo4.depth" value="0.0"/>
    <PARAM id="mod.env1.attack" value="0.01"/>
    <PARAM id="mod.env1.decay" value="0.3"/>
    <PARAM id="mod.env1.sustain" value="0.5"/>
    <PARAM id="mod.env1.release" value="0.5"/>
    <PARAM id="mod.env2.attack" value="0.01"/>
    <PARAM id="mod.env2.decay" value="0.3"/>
    <PARAM id="mod.env2.sustain" value="0.5"/>
    <PARAM id="mod.env2.release" value="0.5"/>
    <PARAM id="mod.env3.attack" value="0.01"/>
    <PARAM id="mod.env3.decay" value="0.3"/>
    <PARAM id="mod.env3.sustain" value="0.5"/>
    <PARAM id="mod.env3.release" value="0.5"/>
    <PARAM id="mod.env4.attack" value="0.01"/>
    <PARAM id="mod.env4.decay" value="0.3"/>
    <PARAM id="mod.env4.sustain" value="0.5"/>
    <PARAM id="mod.env4.release" value="0.5"/>
    <PARAM id="master.gain" value="-6.0"/>
    <ModMatrix>
      <!-- LFO1 sine 0.04Hz → pitch: 0.2×0.04×1200 = 9.6 cents — something breathing -->
      <Route source="0" dest="2" depth="0.04"/>
      <!-- LFO2 triangle 0.08Hz → filter: 0.25×0.12×10k = 300Hz focus shifting -->
      <Route source="1" dest="0" depth="0.12"/>
      <!-- Drift → pitch: organic instability; it's not a still object -->
      <Route source="8" dest="2" depth="0.1"/>
    </ModMatrix>
  </v0idSynthParams>
</V0idPreset>
