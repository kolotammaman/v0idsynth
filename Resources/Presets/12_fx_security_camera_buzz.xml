<?xml version="1.0" encoding="UTF-8"?>
<V0idPreset>
  <metadata name="Security Camera Buzz" category="fx" tags="surveilled,persistent,high"/>
  <v0idSynthParams>
    <!-- Square through BP at high resonance: the specific frequency of being watched -->
    <PARAM id="osc1.waveform" value="1"/>
    <PARAM id="osc1.drive" value="0.4"/>
    <PARAM id="osc2.sample_id" value="0"/>
    <PARAM id="osc.mix" value="0.0"/>
    <PARAM id="filter.cutoff" value="8000.0"/>
    <PARAM id="filter.resonance" value="0.6"/>
    <PARAM id="filter.mode_blend" value="2.0"/>
    <PARAM id="filter.drive" value="0.4"/>
    <PARAM id="filter.env_amount" value="0.0"/>
    <PARAM id="filter.env.attack" value="0.01"/>
    <PARAM id="filter.env.decay" value="0.3"/>
    <PARAM id="filter.env.sustain" value="0.7"/>
    <PARAM id="filter.env.release" value="0.3"/>
    <!-- Immediate on, sustained indefinitely -->
    <PARAM id="amp.env.attack" value="0.001"/>
    <PARAM id="amp.env.decay" value="0.3"/>
    <PARAM id="amp.env.sustain" value="0.95"/>
    <PARAM id="amp.env.release" value="0.1"/>
    <PARAM id="voice.mode" value="0"/>
    <PARAM id="voice.glide" value="0.0"/>
    <PARAM id="voice.unison_voices" value="3"/>
    <PARAM id="voice.unison_detune" value="0.18"/>
    <PARAM id="voice.unison_spread" value="0.4"/>
    <PARAM id="voice.drift" value="0.3"/>
    <!-- LFO1: fast S&H buzz texture on filter; LFO2: slow signal degradation on amp -->
    <PARAM id="mod.lfo1.rate" value="16.0"/>
    <PARAM id="mod.lfo1.waveform" value="4"/>
    <PARAM id="mod.lfo1.depth" value="0.4"/>
    <PARAM id="mod.lfo2.rate" value="0.04"/>
    <PARAM id="mod.lfo2.waveform" value="0"/>
    <PARAM id="mod.lfo2.depth" value="0.2"/>
    <PARAM id="mod.lfo3.rate" value="1.0"/>
    <PARAM id="mod.lfo3.waveform" value="0"/>
    <PARAM id="mod.lfo3.depth" value="0.0"/>
    <PARAM id="mod.lfo4.rate" value="1.0"/>
    <PARAM id="mod.lfo4.waveform" value="0"/>
    <PARAM id="mod.lfo4.depth" value="0.0"/>
    <PARAM id="mod.env1.attack" value="0.01"/>
    <PARAM id="mod.env1.decay" value="0.3"/>
    <PARAM id="mod.env1.sustain" value="0.5"/>
    <PARAM id="mod.env1.release" value="0.5"/>
    <PARAM id="mod.env2.attack" value="0.01"/>
    <PARAM id="mod.env2.decay" value="0.3"/>
    <PARAM id="mod.env2.sustain" value="0.5"/>
    <PARAM id="mod.env2.release" value="0.5"/>
    <PARAM id="mod.env3.attack" value="0.01"/>
    <PARAM id="mod.env3.decay" value="0.3"/>
    <PARAM id="mod.env3.sustain" value="0.5"/>
    <PARAM id="mod.env3.release" value="0.5"/>
    <PARAM id="mod.env4.attack" value="0.01"/>
    <PARAM id="mod.env4.decay" value="0.3"/>
    <PARAM id="mod.env4.sustain" value="0.5"/>
    <PARAM id="mod.env4.release" value="0.5"/>
    <PARAM id="master.gain" value="-12.0"/>
    <ModMatrix>
      <!-- LFO1 S&H 16Hz → filter: 0.4×0.4×10k = 1600Hz fast irregular buzz texture -->
      <Route source="0" dest="0" depth="0.4"/>
      <!-- LFO2 sine 0.04Hz → amp: 0.2×0.1×1 = 0.02 slow signal-level drift -->
      <Route source="1" dest="4" depth="-0.1"/>
    </ModMatrix>
  </v0idSynthParams>
</V0idPreset>
