<?xml version="1.0" encoding="UTF-8"?>
<V0idPreset>
  <metadata name="Maintenance Shaft" category="bass" tags="concrete,punchy,industrial"/>
  <v0idSynthParams>
    <!-- Square wave through heavy drive and filter-slammed mono bass.
         Env2 blooms the resonance on attack then falls. Env1 bends pitch
         down 48 cents on each hit — the weight of the note arriving.
         LFO2 at 3.8Hz adds a fast resonant ripple without tremolo. -->
    <PARAM id="osc1.waveform" value="1"/>
    <PARAM id="osc1.drive" value="0.62"/>
    <PARAM id="osc2.sample_id" value="0"/>
    <PARAM id="osc.mix" value="0.0"/>
    <PARAM id="osc2.root_note" value="60"/>
    <PARAM id="osc2.tune" value="0.0"/>
    <PARAM id="osc2.loop" value="0"/>
    <PARAM id="osc2.gain" value="0.0"/>
    <PARAM id="osc2.hpf" value="20.0"/>
    <PARAM id="osc2.lpf" value="20000.0"/>
    <PARAM id="filter.cutoff" value="200.0"/>
    <PARAM id="filter.resonance" value="0.38"/>
    <PARAM id="filter.mode_blend" value="0.0"/>
    <PARAM id="filter.drive" value="0.52"/>
    <PARAM id="filter.env_amount" value="0.85"/>
    <PARAM id="filter.env.attack" value="0.001"/>
    <PARAM id="filter.env.decay" value="0.22"/>
    <PARAM id="filter.env.sustain" value="0.28"/>
    <PARAM id="filter.env.release" value="0.28"/>
    <PARAM id="amp.env.attack" value="0.004"/>
    <PARAM id="amp.env.decay" value="0.18"/>
    <PARAM id="amp.env.sustain" value="0.88"/>
    <PARAM id="amp.env.release" value="0.3"/>
    <PARAM id="voice.mode" value="1"/>
    <PARAM id="voice.glide" value="0.0"/>
    <PARAM id="voice.unison_voices" value="1"/>
    <PARAM id="voice.unison_detune" value="0.0"/>
    <PARAM id="voice.unison_spread" value="0.0"/>
    <PARAM id="voice.drift" value="0.12"/>
    <PARAM id="mod.lfo1.rate" value="0.08"/>
    <PARAM id="mod.lfo1.waveform" value="0"/>
    <PARAM id="mod.lfo1.depth" value="0.28"/>
    <PARAM id="mod.lfo2.rate" value="3.8"/>
    <PARAM id="mod.lfo2.waveform" value="1"/>
    <PARAM id="mod.lfo2.depth" value="0.48"/>
    <PARAM id="mod.lfo3.rate" value="0.11"/>
    <PARAM id="mod.lfo3.waveform" value="0"/>
    <PARAM id="mod.lfo3.depth" value="0.18"/>
    <PARAM id="mod.lfo4.rate" value="7.2"/>
    <PARAM id="mod.lfo4.waveform" value="3"/>
    <PARAM id="mod.lfo4.depth" value="0.22"/>
    <PARAM id="mod.env1.attack" value="0.001"/>
    <PARAM id="mod.env1.decay" value="0.1"/>
    <PARAM id="mod.env1.sustain" value="0.0"/>
    <PARAM id="mod.env1.release" value="0.08"/>
    <PARAM id="mod.env2.attack" value="0.06"/>
    <PARAM id="mod.env2.decay" value="0.55"/>
    <PARAM id="mod.env2.sustain" value="0.0"/>
    <PARAM id="mod.env2.release" value="0.35"/>
    <PARAM id="mod.env3.attack" value="0.01"/>
    <PARAM id="mod.env3.decay" value="0.3"/>
    <PARAM id="mod.env3.sustain" value="0.5"/>
    <PARAM id="mod.env3.release" value="0.5"/>
    <PARAM id="mod.env4.attack" value="0.01"/>
    <PARAM id="mod.env4.decay" value="0.3"/>
    <PARAM id="mod.env4.sustain" value="0.5"/>
    <PARAM id="mod.env4.release" value="0.5"/>
    <PARAM id="master.gain" value="-3.0"/>
    <ModMatrix>
      <!-- LFO1 sine 0.08Hz → filter: 0.28×0.32×10k=896Hz slow concrete wobble -->
      <Route source="0" dest="0" depth="0.32"/>
      <!-- LFO2 tri 3.8Hz → filter: 0.48×0.16×10k=768Hz fast resonant ripple -->
      <Route source="1" dest="0" depth="0.16"/>
      <!-- LFO3 sine 0.11Hz → pitch: −3¢ barely-perceptible sag, just instability -->
      <Route source="2" dest="2" depth="-0.015"/>
      <!-- LFO4 square 7.2Hz → amp: −3% pulse — the fluorescent flicker of machinery -->
      <Route source="3" dest="4" depth="-0.14"/>
      <!-- Env1 → pitch: −48¢ downward blip on each hit — weight of arrival -->
      <Route source="4" dest="2" depth="-0.04"/>
      <!-- Env2 → resonance: +0.41 bloom on attack (res peaks at 0.79), then falls -->
      <Route source="5" dest="1" depth="0.82"/>
      <!-- Drift → pitch: acoustic instability of concrete space -->
      <Route source="8" dest="2" depth="0.06"/>
    </ModMatrix>
  </v0idSynthParams>
</V0idPreset>
