<?xml version="1.0" encoding="UTF-8"?>
<V0idPreset>
  <metadata name="Server Room Hum" category="bass" tags="electrical,constant,machine"/>
  <v0idSynthParams>
    <!-- Square: hollow machine character, parallel circuits -->
    <PARAM id="osc1.waveform" value="1"/>
    <PARAM id="osc1.drive" value="0.2"/>
    <PARAM id="osc2.sample_id" value="0"/>
    <PARAM id="osc.mix" value="0.0"/>
    <!-- Electrical: more present than structural, not warm -->
    <PARAM id="filter.cutoff" value="500.0"/>
    <PARAM id="filter.resonance" value="0.18"/>
    <PARAM id="filter.mode_blend" value="0.0"/>
    <PARAM id="filter.drive" value="0.25"/>
    <PARAM id="filter.env_amount" value="0.0"/>
    <PARAM id="filter.env.attack" value="0.1"/>
    <PARAM id="filter.env.decay" value="0.3"/>
    <PARAM id="filter.env.sustain" value="0.6"/>
    <PARAM id="filter.env.release" value="0.5"/>
    <!-- Immediate: machines don't hesitate -->
    <PARAM id="amp.env.attack" value="0.05"/>
    <PARAM id="amp.env.decay" value="0.1"/>
    <PARAM id="amp.env.sustain" value="1.0"/>
    <PARAM id="amp.env.release" value="0.3"/>
    <PARAM id="voice.mode" value="2"/>
    <PARAM id="voice.glide" value="0.0"/>
    <!-- 2 voices: the slight beating of parallel circuits -->
    <PARAM id="voice.unison_voices" value="2"/>
    <PARAM id="voice.unison_detune" value="0.04"/>
    <PARAM id="voice.unison_spread" value="0.15"/>
    <!-- Machines are consistent but never perfect -->
    <PARAM id="voice.drift" value="0.05"/>
    <!-- LFO1: ~11s cycle, electrical load variation -->
    <PARAM id="mod.lfo1.rate" value="0.09"/>
    <PARAM id="mod.lfo1.waveform" value="0"/>
    <PARAM id="mod.lfo1.depth" value="0.15"/>
    <PARAM id="mod.lfo2.rate" value="1.0"/>
    <PARAM id="mod.lfo2.waveform" value="0"/>
    <PARAM id="mod.lfo2.depth" value="0.0"/>
    <PARAM id="mod.lfo3.rate" value="1.0"/>
    <PARAM id="mod.lfo3.waveform" value="0"/>
    <PARAM id="mod.lfo3.depth" value="0.0"/>
    <PARAM id="mod.lfo4.rate" value="1.0"/>
    <PARAM id="mod.lfo4.waveform" value="0"/>
    <PARAM id="mod.lfo4.depth" value="0.0"/>
    <PARAM id="mod.env1.attack" value="0.01"/>
    <PARAM id="mod.env1.decay" value="0.3"/>
    <PARAM id="mod.env1.sustain" value="0.5"/>
    <PARAM id="mod.env1.release" value="0.5"/>
    <PARAM id="mod.env2.attack" value="0.01"/>
    <PARAM id="mod.env2.decay" value="0.3"/>
    <PARAM id="mod.env2.sustain" value="0.5"/>
    <PARAM id="mod.env2.release" value="0.5"/>
    <PARAM id="mod.env3.attack" value="0.01"/>
    <PARAM id="mod.env3.decay" value="0.3"/>
    <PARAM id="mod.env3.sustain" value="0.5"/>
    <PARAM id="mod.env3.release" value="0.5"/>
    <PARAM id="mod.env4.attack" value="0.01"/>
    <PARAM id="mod.env4.decay" value="0.3"/>
    <PARAM id="mod.env4.sustain" value="0.5"/>
    <PARAM id="mod.env4.release" value="0.5"/>
    <PARAM id="master.gain" value="-3.0"/>
    <ModMatrix>
      <!-- LFO1 sine 0.09Hz → filter: 0.15×0.08×10k = 120Hz slow electrical wobble -->
      <Route source="0" dest="0" depth="0.08"/>
    </ModMatrix>
  </v0idSynthParams>
</V0idPreset>
